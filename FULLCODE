eps0=8.8541878128e-12
me=9.1093837e-31
c=2.99792458e8
m_a=6.644657e-27
MeV=1.602176634e-13

def S_bethe(E, n_e, I_eV, z=2):
    I = I_eV*e
    b2 = 1-(1+E*MeV/(m_a*c**2))**-2
    b  = np.sqrt(b2)
    zeff2 = z**2*(1-np.exp(-125*b/z**(2/3)))**2           # effective charge -> peak drops
    L = np.log(2*me*c**2*b2/(I*(1-b2)))-b2
    return 4*np.pi*n_e*zeff2/(me*c**2*b2)*(e**2/(4*np.pi*eps0))**2*L/(MeV*100)   # MeV/cm

def bragg(E0_MeV, n_e, I_eV, Ec=0.5):
    E = np.linspace(E0_MeV, Ec, 20000); S = S_bethe(E, n_e, I_eV)
    Elo = np.linspace(Ec, 1e-4, 4000); Slo = S[-1]*np.sqrt(Elo/Ec)   # S ~ sqrt(E) below Ec
    E = np.concatenate([E, Elo[1:]]); S = np.concatenate([S, Slo[1:]])
    x = np.concatenate([[0], np.cumsum(0.5*(1/S[1:]+1/S[:-1])*(E[:-1]-E[1:]))])   # cm
    return x, S, E

